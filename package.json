{
	"name": "pi-session-list",
	"version": "0.2.0",
	"description": "Browse, search, and read saved pi sessions from inside pi: a /sessions picker with resume and preview, plus recent_sessions and session_transcript tools for the model",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"sessions",
		"session-history",
		"resume",
		"search",
		"transcript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/armagg/pi-sessions.git"
	},
	"type": "module",
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/sessions.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
